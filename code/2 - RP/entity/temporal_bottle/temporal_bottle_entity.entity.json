{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "temporal_bottle:temporal_zone",
      "materials": { "default": "entity_alphatest_one_sided" },
      "textures": {
        "speed_2x": "textures/temporal_bottle/entity/2x",
        "speed_4x": "textures/temporal_bottle/entity/4x",
        "speed_8x": "textures/temporal_bottle/entity/8x",
        "speed_16x": "textures/temporal_bottle/entity/16x",
        "speed_32x": "textures/temporal_bottle/entity/32x",
        "speed_64x": "textures/temporal_bottle/entity/64x",
        "speed_128x": "textures/temporal_bottle/entity/128x",
        "speed_256x": "textures/temporal_bottle/entity/256x",
        "speed_512x": "textures/temporal_bottle/entity/512x",
        "speed_1024x": "textures/temporal_bottle/entity/1024x",
        "search_background": "textures/temporal_bottle/entity/search/search_background",
        "search_timer": "textures/temporal_bottle/entity/search/search_timer"
      },
      "geometry": { "default": "geometry.temporal_bottle.temporal_zone" },
      "scripts": {
        "scale": "1.005",
        "pre_animation": [
          "v.tier = q.property('temporal_bottle:tier');",
          "v.searching = q.property('temporal_bottle:search');"
        ],
        "animate": [
          { "search_10": "v.searching == 1" },
          { "search_20": "v.searching == 2" }
        ]
      },
      "animations": {
        "search_10": "animation.temporal_bottle.temporal_zone.timer.10",
        "search_20": "animation.temporal_bottle.temporal_zone.timer.20"
      },
      "render_controllers": [
        "controller.render.temporal_bottle.temporal_zone",
        { "controller.render.temporal_bottle.temporal_zone.searching": "v.searching > 0" }
      ]
    }
  }
}